# Any OpenAI-compatible model with tool calling works. Fill in all three lines.
# Model names change; check your platform's model list if one is rejected.
# After switching vendor or model, run: npm run check-model

# DeepSeek (default). Key: https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# Kimi (Moonshot). Key: https://platform.moonshot.cn/console/api-keys
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2-0905-preview
# Thinking models (kimi-k2-thinking and similar) work too; their reasoning is sent back automatically.
# If a model only accepts its own temperature, add LLM_TEMPERATURE=default (Lumi also adapts on its own).

# Zhipu GLM. Key: https://open.bigmodel.cn/usercenter/apikeys
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# Qwen (Alibaba Bailian / DashScope). Key: https://bailian.console.aliyun.com
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Optional
# LLM_MODEL_FREE=           # cheaper model for Free users (Part A, A3). Defaults to LLM_MODEL
# PORT=3000
# BASE_URL=http://localhost:3000   # domain used in tracked links when deployed
# LLM_TEMPERATURE=default   # leave temperature out for models with a fixed value
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}   # vendor-specific request fields, as JSON
# DEMO_TOOLS=off            # hides the demo helpers and the simulated payment page (off by default when NODE_ENV=production)
# ADMIN_TOKEN=              # protects /admin; open /admin?token=... (required to open it in production)
# BILLING_WEBHOOK_SECRET=   # signs the payment webhook (required in production)
